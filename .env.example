# Shared environment for the whole workspace.
#
# Every variable here must also be declared in turbo.json under `globalEnv`,
# otherwise Turborepo's strict mode filters it out of task environments and
# changes to it will not invalidate the cache.
#
# Turborepo does not load this file. `dotenv-cli` in the package scripts does
# (see packages/db/package.json), and Vite loads it for apps/web via `envDir`.
#
# Copy to .env:  cp .env.example .env

# Local Postgres from docker-compose.yml.
DATABASE_URL=postgres://relivo:relivo@localhost:5432/relivo

# Redis for BullMQ, also from docker-compose.yml.
# The container runs with `--maxmemory-policy noeviction`; BullMQ requires it.
# Any eviction policy lets Redis silently drop job state under memory pressure.
REDIS_URL=redis://localhost:6379

# Better Auth. The secret signs and encrypts sessions — 32 chars minimum, and
# changing it invalidates every existing session.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth, currently the only way to sign in. Create credentials at
# https://console.cloud.google.com/apis/credentials and register
# http://localhost:3000/api/auth/callback/google as the redirect URI.
# Leave both blank and the sign-in page says so instead of crashing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
