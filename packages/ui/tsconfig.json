{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",

    /* Bundler mode. The shared @repo/typescript-config presets are
       NodeNext/Next.js-era and deliberately not extended. */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Self-referencing imports: components generated by the shadcn CLI import
       `@repo/ui/lib/utils`, which must resolve back into this package's own src. */
    "paths": {
      "@repo/ui/*": ["./src/*"]
    },

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
