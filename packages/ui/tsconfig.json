{
  "extends": "@repo/typescript-config/react.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    /* Components generated by the shadcn CLI import through this package's own
       name (@repo/ui/lib/utils), so it has to resolve back into src. */
    "paths": {
      "@repo/ui/*": ["./src/*"]
    }
  }
}
